[settings]
experimental = true
go_set_gobin = true

[wrappers]
cargo = { command = "mbx", env = { MBX_CARGO_SHIM_MODE = "1" } }

[tools]
"aqua:grafana/gcx" = "latest"
# TODO: switch to upstream mdserve when my PRs are merged
# "github:jfernandez/mdserve" = "latest"
"cargo:https://github.com/quodlibetor/mdserve" = "branch:bwm-main"
"cargo:https://github.com/quodlibetor/miniserve" = "branch:bwmmain"
# "github:svenstaro/miniserve" = { version = "latest", matching = "miniserve", rename_exe = "miniserve", bin = "miniserve" }
"github:DeCarabas/fwd" = "latest"
"github:eza-community/eza" = "latest"
"github:golangci/golangci-lint" = "latest"
"github:ilyagr/diffedit3" = "latest"
"github:jesseduffield/lazygit" = "latest"
"github:michel-kraemer/zsh-patina" = "latest"
"github:quodlibetor/git-instafix" = "latest"
"github:quodlibetor/s3glob" = "latest"
"github:terrastruct/d2" = "latest"
"go:github.com/go-delve/delve/cmd/dlv" = "latest"
"go:golang.org/x/tools/gopls" = "latest"
"pipx:git-delete-merged-branches" = "latest"
"pipx:ruff" = "latest"
bat = "latest"
chezmoi = "latest"
claude-code = { version = "latest", minimum_release_age = "0m" }
difftastic = "latest"
dust = "latest"
fzf = "latest"
gh = "latest"
go = "latest"
jj = { version = "latest", minimum_release_age = "0m" }
jjui = "latest"
jq = "latest"
k9s = "latest"
mr-boxington = { version = "latest", minimum_release_age = "0m", postinstall = "mbx setup --yes" }
node = "latest"
op = "latest"
python = "latest"
ripgrep = { version = "latest", exe = "rg" }
semgrep = "latest"
shellcheck = "latest"
starship = "latest"
stylua = "latest"
tokei = "latest"
uv = "latest"
zoxide = "latest"

# the various sprs
"github:ejoffe/spr" = "latest"
# "cargo:https://github.com/jennings/jj-spr.git" = "branch:main"
"cargo:https://github.com/quodlibetor/jj-spr.git" = "branch:bwmmain"

{{- if not (or (stat (joinPath .chezmoi.homeDir ".local/bin/vcs-status-daemon"))
               (stat (joinPath .chezmoi.homeDir ".cargo/bin/vcs-status-daemon"))) }}
{{/* if this exists I've installed from source */}}
"github:quodlibetor/vcs-status-daemon" = { version = "latest", minimum_release_age = "0m" }
{{- end -}}
{{ if (or (eq .chezmoi.os "linux")
          (not (eq .chezmoi.arch "amd64"))) -}}
{{/* packages which don't build for intel macs */}}
"github:chronologos/lightjj" = "latest"
{{- end }}
{{- if eq .chezmoi.os "linux" }}
btop = "latest"
delta = "latest"
fd = "latest"
# mbx points its linker selection at this install, so mise owns the version
"github:wild-linker/wild" = "latest"
{{- end }}

# Written by `mbx setup`: puts mbx's cargo shim ahead of rustup's in every mise scope.
# ~/.zshenv covers the shells mise does not activate.
[env._]
path = ["~/.local/share/mbx/bin"]
